# Copy to `.env.local` for a local run, or set these in the host's dashboard.
# Nothing here is secret: the site has no server, no accounts and no keys.

# Where the site actually lives, used for the social card, the canonical URLs
# and the sitemap. Leave it unset and Vercel's own hostname is used, which
# works but puts a *.vercel.app address in every shared link and every search
# result. Set it the day there is a real domain. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://example.com

# PostHog. The project's write-only key, which is public by design: it ships
# inside the page's JavaScript and can only send events, never read them.
# Unset, the library is never loaded, no request is made and no host is added
# to the content security policy.
NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
# US Cloud by default. Use https://eu.i.posthog.com for an EU project.
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Optional. Sends events from `next dev` too, with the library's own debug
# logging on, which is how you watch an event that never fires.
# NEXT_PUBLIC_POSTHOG_IN_DEV=1
# Optional. Loads the session recorder, which also has to be switched on in
# the PostHog project itself. Off by default because it is the heaviest thing
# PostHog can load and this site was slow once already.
# NEXT_PUBLIC_POSTHOG_REPLAY=1
